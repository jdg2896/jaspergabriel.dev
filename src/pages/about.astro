---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalIcon from "../components/ExternalIcon.astro";
import { person, toJsonLd } from "../utils/schema";
import { Image } from "astro:assets";
import photo from "../assets/jasper-gabriel.jpg";
import { readFileSync } from "node:fs";
import sharp from "sharp";

// The photo is mostly white, so the dark theme's placeholder panel showed
// as a black square until it loaded. A tiny blurred copy, inlined as the
// background, shows the photo's own colors instead. Resolved from the
// project root, as in the OG route.
const placeholder = await sharp(readFileSync("./src/assets/jasper-gabriel.jpg"))
  .resize(16, 16)
  .blur()
  .webp({ quality: 50 })
  .toBuffer();
const placeholderStyle = `background-image: url(data:image/webp;base64,${placeholder.toString("base64")})`;
---

<BaseLayout
  title="About — Jasper Gabriel"
  description="A bit about me — who I am, what I do, and what I care about."
  schema={toJsonLd({ '@type': 'ProfilePage', mainEntity: person })}
>
  <div class="container">
    <h1>About</h1>
    <div class="about-content prose">
      <Image
        class="about-photo"
        src={photo}
        alt="Jasper Gabriel"
        width={360}
        height={360}
        loading="eager"
        fetchpriority="high"
        style={placeholderStyle}
      />
      <p>
        Hello world, I'm Jasper Gabriel, a software engineer specializing in
        backend systems and cloud infrastructure. I've spent the last 4 years
        building fintech and crypto products.
      </p>
      <p>
        I do my best work at early-stage startups, where I get to wear multiple
        hats and work across the whole stack.
      </p>
      <p>
        Lately I'm exploring cryptography, zero-knowledge proofs, and
        cybersecurity.
      </p>
      <p>
        This site is where I <a href="/blog/">write down what I learn</a> about
        coding, career, side projects, and anything else that piques my interest.
      </p>
      <p>
        When I'm not building software, I'm probably reading, playing video
        games, watching YouTube videos, or playing the piano.
      </p>
      <p>
        You can find me on <a
          href="https://github.com/jdg2896"
          target="_blank"
          rel="noopener noreferrer">GitHub<ExternalIcon /></a
        > or <a
          href="https://linkedin.com/in/jaspergabriel"
          target="_blank"
          rel="noopener noreferrer">LinkedIn<ExternalIcon /></a
        >, or reach me directly at <a href="mailto:jasper.d.gabriel@gmail.com"
          >jasper.d.gabriel@gmail.com</a
        >.
      </p>
    </div>
  </div>
</BaseLayout>
