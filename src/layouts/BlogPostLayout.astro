---
import BaseLayout from './BaseLayout.astro';
import ToastButton from '../components/ToastButton.astro';
import { getReadingTime } from '../utils/readingTime';

interface PostLink {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  rawContent: string;
  canonicalUrl?: string;
  slug: string;
  newerPost?: PostLink | null;
  olderPost?: PostLink | null;
}

const { title, description, pubDate, updatedDate, rawContent, canonicalUrl, slug, newerPost, olderPost } = Astro.props;

const readingTime = getReadingTime(rawContent);
const canonicalHost = canonicalUrl && new URL(canonicalUrl).hostname.replace(/^www\./, '');

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — Jasper Gabriel`} description={description} canonicalUrl={canonicalUrl}>
  <div class="container">
    <article>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-header__meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
          {updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      {canonicalUrl && (
        <p class="originally-published">
          Originally published on <a href={canonicalUrl} target="_blank" rel="noopener noreferrer">{canonicalHost}</a>
        </p>
      )}

      <div class="prose">
        <slot />
      </div>

      <ToastButton slug={slug} />
    </article>

    {
      (olderPost || newerPost) && (
        <nav class="post-nav" aria-label="Post navigation">
          {olderPost ? (
            <a class="post-nav__link" href={`/blog/${olderPost.slug}`} rel="prev">
              <span class="post-nav__label">&larr; Older</span>
              <span class="post-nav__title">{olderPost.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newerPost && (
            <a class="post-nav__link post-nav__link--next" href={`/blog/${newerPost.slug}`} rel="next">
              <span class="post-nav__label">Newer &rarr;</span>
              <span class="post-nav__title">{newerPost.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
