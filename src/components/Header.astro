---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="site-logo">Jasper Gabriel</a>
    <div class="site-header__actions">
      <nav>
        <ul class="site-nav">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={currentPath === href || (href !== '/' && currentPath.startsWith(href)) ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" class="theme-toggle" aria-label="Dark mode" aria-pressed="false">
        <svg class="theme-toggle__moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <svg class="theme-toggle__sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2m-7.07-2.93 1.41-1.41m11.32-11.32 1.41-1.41M2 12h2m16 0h2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  function bindThemeToggle() {
    const toggle = document.querySelector('.theme-toggle');
    if (!toggle) return;

    // Expose the current theme to assistive tech as the toggle's pressed state
    const syncPressed = () =>
      toggle.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
    syncPressed();

    toggle.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      // Switch every color at once, then restore transitions after the
      // new theme has painted
      root.classList.add('theme-switching');
      root.dataset.theme = next;
      syncPressed();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => root.classList.remove('theme-switching'))
      );
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  }

  // The header is re-rendered on every client-side navigation
  document.addEventListener('astro:page-load', bindThemeToggle);
</script>
