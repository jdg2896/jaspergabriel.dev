---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  schema?: string;
}

const { title, description, canonicalUrl, image, article, schema } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} article={article} schema={schema} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // <main> is focusable only while the skip link has sent focus there. Left
  // focusable, a tap on the page focuses it, and LinkedIn's in-app browser
  // then scrolls it into view, back to the top, whenever its toolbar resizes
  // the page. Capture runs before ClientRouter, which skips prevented clicks.
  document.addEventListener(
    'click',
    (event) => {
      const link = (event.target as Element).closest?.('.skip-link');
      const main = document.getElementById('main');
      if (!link || !main) return;
      event.preventDefault();
      main.tabIndex = -1;
      main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true });
      main.focus();
    },
    true,
  );
</script>

<style is:global>
  /* Disable default view transition animations for instant nav */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>
