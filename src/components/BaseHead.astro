---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
}

const { title, description, canonicalUrl, image, article } = Astro.props;
// Overridden only when a post's canonical home is another platform
// (e.g. freeCodeCamp's terms require their copy to be canonical).
const canonicalURL = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site);
const imageURL = image && new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // Runs before paint to avoid a flash of the wrong theme. ClientRouter
  // replaces <html> attributes on navigation, so reapply after each swap.
  function applyTheme() {
    let theme;
    try {
      theme = localStorage.getItem('theme');
    } catch {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.dataset.theme = theme;
  }
  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);
</script>
<!-- These controls need JS; without it, hide them rather than show dead ones -->
<noscript><style>.theme-toggle, .code-block__bar { display: none !important; }</style></noscript>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- Linked from the head (not @import-ed in CSS) so font loading starts in parallel -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap"
/>
<link rel="canonical" href={canonicalURL} />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Jasper Gabriel"
  href={new URL("rss.xml", Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Jasper Gabriel" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content="Jasper Gabriel" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && (
  <>
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    <meta property="article:author" content={new URL('/about/', Astro.site)} />
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta property="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{imageURL && <meta property="twitter:image" content={imageURL} />}
