---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ToastButton from '../components/ToastButton.astro';
import ExternalIcon from '../components/ExternalIcon.astro';
import { getReadingTime } from '../utils/readingTime';

interface RelatedPost {
  slug: string;
  title: string;
  pubDate: Date;
  readingTime: number;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  rawContent: string;
  canonicalUrl?: string;
  slug: string;
  headings?: MarkdownHeading[];
  relatedPosts?: RelatedPost[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  rawContent,
  canonicalUrl,
  slug,
  headings = [],
  relatedPosts = [],
} = Astro.props;

const readingTime = getReadingTime(rawContent);
const canonicalHost = canonicalUrl && new URL(canonicalUrl).hostname.replace(/^www\./, '');

// Contents list for posts long enough to need one. Deep posts drop to
// top-level sections only, so the list stays a glance, not a second read.
const TOC_MIN_SECTIONS = 4;
const TOC_MIN_MINUTES = 6;
const TOC_MAX = 12;
const sections = headings.filter((h) => h.depth === 2 || h.depth === 3);
const toc = sections.length > TOC_MAX ? sections.filter((h) => h.depth === 2) : sections;
const showToc = toc.length >= TOC_MIN_SECTIONS && readingTime >= TOC_MIN_MINUTES;

// Content dates are coerced at UTC midnight; format them in UTC so a build
// west of Greenwich doesn't show the day before.
const formatDate = (date: Date, month: 'long' | 'short' = 'long') =>
  date.toLocaleDateString('en-US', { year: 'numeric', month, day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={`${title} — Jasper Gabriel`}
  description={description}
  canonicalUrl={canonicalUrl}
  image={`/og/${slug}.png`}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
>
  <div class="container">
    <article>
      <header class="post-header">
        <h1>{title}</h1>
        <p class="post-header__lede">{description}</p>
        <div class="post-header__meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
          {updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      {canonicalUrl && (
        <p class="originally-published">
          Originally published on{' '}
          <a href={canonicalUrl} target="_blank" rel="noopener noreferrer">
            {canonicalHost}<ExternalIcon />
          </a>
        </p>
      )}

      {showToc && (
        <details class="post-toc">
          <summary>
            On this page
            <span class="post-toc__count">{toc.length} sections</span>
          </summary>
          <nav aria-label="On this page">
            <ol>
              {toc.map((heading) => (
                <li class:list={{ 'post-toc__sub': heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        <ToastButton slug={slug} />

        <!-- Contact links live in the header, so the sign-off is just the introduction -->
        <p class="signoff">
          I'm <a href="/about/">Jasper Gabriel</a>, a software engineer. I write about my experiences and
          the things I learn.
        </p>
      </footer>
    </article>

    {relatedPosts.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="section-header">
          <h2 id="related-heading">Keep reading</h2>
        </div>
        <ul class="post-list">
          {relatedPosts.map((post) => (
            <li class="post-card">
              <div class="post-card__meta">
                <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate, 'short')}</time>
                <span aria-hidden="true">&middot;</span>
                <span>{post.readingTime} min read</span>
              </div>
              <h3 class="post-card__title">
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </h3>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <!-- One shared live region, so a copy is announced without moving focus -->
  <p class="visually-hidden" role="status" id="code-copy-status"></p>

  <!-- Screenshots shrunk to fit the column open here at full size -->
  <dialog class="lightbox" aria-label="Full-size image" tabindex="-1">
    <button type="button" class="lightbox__close" aria-label="Close image">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
    <img class="lightbox__img" alt="" />
  </dialog>
</BaseLayout>

<script>
  // Delegated, so it survives ClientRouter swaps without re-binding
  const RESET_MS = 2000;
  const timers = new WeakMap<HTMLButtonElement, number>();

  const flash = (button: HTMLButtonElement, state: 'copied' | 'failed') => {
    const status = document.getElementById('code-copy-status');
    button.dataset.state = state;
    button.textContent = state === 'copied' ? 'Copied' : "Couldn't copy";
    if (status) {
      status.textContent =
        state === 'copied'
          ? 'Code copied to clipboard.'
          : "Couldn't copy. Select the code and copy it by hand.";
    }
    clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.state;
        button.textContent = 'Copy';
      }, RESET_MS),
    );
  };

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.code-copy');
    const code = button?.closest('.code-block')?.querySelector('pre code');
    if (!button || !code) return;
    try {
      await navigator.clipboard.writeText(code.textContent ?? '');
      flash(button, 'copied');
    } catch {
      flash(button, 'failed');
    }
  });

  // Images whose original is wider than they render can be opened full size.
  // The width attribute is the original's (Astro sets it), and the plain src
  // is the original-size file; srcset only serves column-sized copies.
  const markZoomable = () => {
    for (const img of document.querySelectorAll<HTMLImageElement>('.prose img')) {
      const zoomable = img.width < Number(img.getAttribute('width'));
      img.toggleAttribute('data-zoomable', zoomable);
      if (zoomable) {
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.setAttribute('aria-haspopup', 'dialog');
      } else {
        img.removeAttribute('tabindex');
        img.removeAttribute('role');
        img.removeAttribute('aria-haspopup');
      }
    }
  };

  const openImage = (img: HTMLImageElement) => {
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const view = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
    if (!dialog || !view) return;
    // Cleared first, so the last image doesn't flash before this one loads
    view.removeAttribute('src');
    view.width = Number(img.getAttribute('width'));
    view.height = Number(img.getAttribute('height'));
    view.alt = img.alt;
    view.src = img.getAttribute('src') ?? '';
    dialog.showModal();
    // showModal focuses the close button, which then opens ringed; the
    // dialog itself takes focus instead, and Tab still reaches the button
    dialog.focus();
  };

  document.addEventListener('astro:page-load', markZoomable);
  window.addEventListener('resize', markZoomable);

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    // Anywhere in the open view closes it: the image, the backdrop, or the button
    const dialog = target.closest<HTMLDialogElement>('.lightbox');
    if (dialog) {
      dialog.close();
      return;
    }
    const img = target.closest<HTMLImageElement>('.prose img[data-zoomable]');
    if (img) openImage(img);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const img = (event.target as Element).closest<HTMLImageElement>('.prose img[data-zoomable]');
    if (!img) return;
    event.preventDefault();
    openImage(img);
  });
</script>
