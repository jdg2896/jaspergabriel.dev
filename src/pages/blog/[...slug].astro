---
import { getCollection, render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Sorted newest-first, so the next index is the older post.
      newerPost: posts[i - 1] ?? null,
      olderPost: posts[i + 1] ?? null,
    },
  }));
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  rawContent={post.body ?? ""}
  canonicalUrl={post.data.canonicalUrl}
  slug={post.id}
  newerPost={newerPost && { slug: newerPost.id, title: newerPost.data.title }}
  olderPost={olderPost && { slug: olderPost.id, title: olderPost.data.title }}
>
  <Content />
</BlogPostLayout>
