# Cache static assets aggressively (Astro hashes filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons keep fixed names, so they're cached for a day rather than forever:
# every page asks for them, and a changed icon still shows up by tomorrow
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# HTML stays fresh for a minute. That's long enough for the client router's
# fetch on click to reuse the page prefetched when its link scrolled into
# view, and short enough that a deploy shows up almost immediately.
/*.html
  Cache-Control: public, max-age=60, must-revalidate

/
  Cache-Control: public, max-age=60, must-revalidate

/about/
  Cache-Control: public, max-age=60, must-revalidate

# Also matches /blog/ itself
/blog/*
  Cache-Control: public, max-age=60, must-revalidate
