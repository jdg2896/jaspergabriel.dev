---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "../utils/readingTime";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<BaseLayout
  title="Jasper Gabriel"
  description="Software engineer. Writes about learnings and experiences."
>
  <div class="container">
    <section class="hero">
      <p class="hero__greeting">Hello world, I'm</p>
      <h1 class="hero__name">Jasper Gabriel</h1>
      <p class="hero__bio">
        Software engineer who turns ideas from zero to production and
        occasionally write about what I'm learning, working on, or thinking
        about.
      </p>
    </section>

    {
      recentPosts.length > 0 && (
        <section>
          <div class="section-header">
            <h2>Recent posts</h2>
            <a href="/blog">All posts &rarr;</a>
          </div>
          <ul class="post-list">
            {recentPosts.map((post) => {
              const readingTime = getReadingTime(post.body ?? "");
              return (
                <li class="post-card">
                  <div class="post-card__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                    <span aria-hidden="true">&middot;</span>
                    <span>{readingTime} min read</span>
                  </div>
                  <h3 class="post-card__title">
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h3>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
