---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found — Jasper Gabriel"
  description="The page you're looking for doesn't exist."
>
  <div class="container">
    <h1>Page not found</h1>
    <p
      style="color: var(--color-text-muted); margin-top: 0.75rem; margin-bottom: 2rem;"
    >
      The page you're looking for doesn't exist or has moved.
    </p>
    <p>
      <a href="/">Go home</a> or <a href="/blog">browse the blog</a>.
    </p>
  </div>
</BaseLayout>
