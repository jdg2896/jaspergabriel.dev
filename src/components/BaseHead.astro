---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  // Serialized JSON-LD from utils/schema
  schema?: string;
}

// Pages without their own card share the site-wide one
const { title, description, canonicalUrl, image = '/og/site.png', article, schema } = Astro.props;
// Overridden only when a post's canonical home is another platform
// (e.g. freeCodeCamp's terms require their copy to be canonical).
const canonicalURL = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site);
const imageURL = image && new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // Runs before paint to avoid a flash of the wrong theme. ClientRouter
  // replaces <html> attributes on navigation, so reapply after each swap.
  function applyTheme() {
    let theme;
    try {
      theme = localStorage.getItem('theme');
    } catch {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.dataset.theme = theme;
  }
  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);

  // A full page load otherwise paints the top of the page, then jumps at
  // DOMContentLoaded: to the #heading on a fresh link, or, on reload and
  // back/forward, to the position ClientRouter saved in history.state. Both
  // land here before the first paint instead. rel=expect holds that paint
  // until the page is parsed up to the footer (Chrome; others ignore it),
  // and the scroll runs in a frame callback, which comes before paint.
  const saved = history.state;
  const restoring = typeof saved?.scrollY === 'number';
  // ClientRouter restores the same position when its script runs at the end
  // of parsing. In-app browsers reload slowly when you return to them, so a
  // reader may already be scrolling by then, and either restore would snap
  // them back. Their input wins: both are skipped for the rest of the load.
  // readyState excludes reruns after a ClientRouter navigation.
  if (restoring && document.readyState === 'loading') {
    const nativeScrollTo = window.scrollTo;
    const inputs = ['wheel', 'touchstart', 'keydown'];
    const stopListening = () =>
      inputs.forEach((type) => removeEventListener(type, yieldToReader, true));
    const yieldToReader = () => {
      window.scrollTo = () => {};
      stopListening();
    };
    inputs.forEach((type) => addEventListener(type, yieldToReader, { capture: true, passive: true }));
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        window.scrollTo = nativeScrollTo;
        stopListening();
      },
      { once: true },
    );
  }
  if (restoring || location.hash.length > 1) {
    const expect = document.createElement('link');
    expect.rel = 'expect';
    expect.href = '#site-footer';
    expect.setAttribute('blocking', 'render');
    document.head.append(expect);

    const land = () => {
      if (!document.getElementById('site-footer') && document.readyState === 'loading') {
        requestAnimationFrame(land);
        return;
      }
      if (restoring) {
        scrollTo(saved.scrollX ?? 0, saved.scrollY);
      } else {
        let id = location.hash.slice(1);
        try {
          id = decodeURIComponent(id);
        } catch {}
        document.getElementById(id)?.scrollIntoView();
      }
      // Images are lazy and decode async, so the first paint would show
      // their loading panels for a frame or two. Those now in view load at
      // once and decode in that paint; on a reload they're in cache.
      for (const img of document.querySelectorAll('.prose img')) {
        const { top, bottom } = img.getBoundingClientRect();
        if (bottom > 0 && top < innerHeight) {
          img.loading = 'eager';
          img.decoding = 'sync';
        }
      }
    };
    requestAnimationFrame(land);
  }
</script>
<!-- These controls need JS; without it, hide them rather than show dead ones -->
<noscript><style>.theme-toggle, .code-block__bar { display: none !important; }</style></noscript>
<!-- SVG for browsers; the .ico is what crawlers (and Google's results) fetch
     by default, and iOS wants a square PNG it rounds itself -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Jasper Gabriel"
  href={new URL("rss.xml", Astro.site)}
/>
<link
  rel="alternate"
  type="application/atom+xml"
  title="Jasper Gabriel"
  href={new URL("atom.xml", Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Jasper Gabriel" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content="Jasper Gabriel" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && (
  <>
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    <meta property="article:author" content={new URL('/about/', Astro.site)} />
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta property="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{imageURL && <meta property="twitter:image" content={imageURL} />}

{schema && <script is:inline type="application/ld+json" set:html={schema} />}
