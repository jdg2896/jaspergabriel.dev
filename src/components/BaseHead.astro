---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  // Serialized JSON-LD from utils/schema
  schema?: string;
}

// Pages without their own card share the site-wide one
const { title, description, canonicalUrl, image = '/og/site.png', article, schema } = Astro.props;
// Overridden only when a post's canonical home is another platform
// (e.g. freeCodeCamp's terms require their copy to be canonical).
const canonicalURL = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site);
const imageURL = image && new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // Runs before paint to avoid a flash of the wrong theme. ClientRouter
  // replaces <html> attributes on navigation, so reapply after each swap.
  function applyTheme() {
    let theme;
    try {
      theme = localStorage.getItem('theme');
    } catch {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.dataset.theme = theme;
  }
  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);

  // TEMPORARY: on-screen log for the LinkedIn in-app browser scroll jump,
  // only with ?scrolldebug in the URL. Remove once the cause is found.
  if (location.search.includes('scrolldebug') && !window.__scrollDebug) {
    window.__scrollDebug = true;
    const t0 = performance.now();
    let lines = [];
    try {
      lines = JSON.parse(sessionStorage.getItem('scrolldebug') || '[]');
    } catch {}
    let box;
    const log = (msg) => {
      const focus = document.activeElement;
      const f = focus ? focus.tagName + (focus.id ? '#' + focus.id : '') : '-';
      const vv = window.visualViewport;
      lines.push(
        `${Math.round(performance.now() - t0)} ${msg} | y=${Math.round(scrollY)} ih=${innerHeight}` +
          ` vv=${vv ? Math.round(vv.height) + '@' + Math.round(vv.offsetTop) : '-'}` +
          ` dh=${document.documentElement.scrollHeight} f=${f}`,
      );
      lines = lines.slice(-40);
      try {
        sessionStorage.setItem('scrolldebug', JSON.stringify(lines));
      } catch {}
      if (box) box.textContent = lines.slice(-14).join('\n');
    };
    const caller = () =>
      (new Error().stack || '').split('\n').slice(2, 4).map((s) => s.trim().slice(-60)).join(' < ');
    const nav = performance.getEntriesByType('navigation')[0];
    log(`LOAD ${nav ? nav.type : '?'} state=${JSON.stringify(history.state)}`);

    const wrap = (obj, name) => {
      const orig = obj[name];
      obj[name] = function (...args) {
        log(`${name}(${JSON.stringify(args[0])?.slice(0, 40)}) from ${caller()}`);
        return orig.apply(this, args);
      };
    };
    wrap(window, 'scrollTo');
    wrap(window, 'scroll');
    wrap(Element.prototype, 'scrollIntoView');
    wrap(HTMLElement.prototype, 'focus');
    wrap(history, 'replaceState');
    wrap(history, 'pushState');

    let lastY = scrollY;
    addEventListener(
      'scroll',
      () => {
        if (Math.abs(scrollY - lastY) > 150) log(`JUMP from ${Math.round(lastY)}`);
        lastY = scrollY;
      },
      { passive: true },
    );
    for (const type of ['resize', 'pageshow', 'pagehide', 'popstate', 'hashchange', 'orientationchange']) {
      addEventListener(type, (e) => log(type + (e.persisted ? ' persisted' : '')));
    }
    window.visualViewport?.addEventListener('resize', () => log('vv-resize'));
    document.addEventListener('visibilitychange', () => log('visibility ' + document.visibilityState));
    document.addEventListener('focusin', () => log('focusin'));
    addEventListener('touchend', () => log('touchend'), { passive: true });

    document.addEventListener('DOMContentLoaded', () => {
      box = document.createElement('pre');
      box.style.cssText =
        'position:fixed;left:4px;right:4px;top:40%;z-index:9999;margin:0;padding:4px;' +
        'font:10px/1.3 ui-monospace,monospace;white-space:pre-wrap;word-break:break-all;' +
        'background:rgba(0,0,0,.75);color:#7f7;pointer-events:none;max-height:45vh;overflow:hidden';
      document.body.append(box);
      log('DOMContentLoaded');
    });
  }

  // A full page load otherwise paints the top of the page, then jumps at
  // DOMContentLoaded: to the #heading on a fresh link, or, on reload and
  // back/forward, to the position ClientRouter saved in history.state. Both
  // land here before the first paint instead. rel=expect holds that paint
  // until the page is parsed up to the footer (Chrome; others ignore it),
  // and the scroll runs in a frame callback, which comes before paint.
  const saved = history.state;
  const restoring = typeof saved?.scrollY === 'number';
  // ClientRouter restores the same position when its script runs at the end
  // of parsing. In-app browsers reload slowly when you return to them, so a
  // reader may already be scrolling by then, and either restore would snap
  // them back. Their input wins: both are skipped for the rest of the load.
  // readyState excludes reruns after a ClientRouter navigation.
  if (restoring && document.readyState === 'loading') {
    const nativeScrollTo = window.scrollTo;
    const inputs = ['wheel', 'touchstart', 'keydown'];
    const stopListening = () =>
      inputs.forEach((type) => removeEventListener(type, yieldToReader, true));
    const yieldToReader = () => {
      window.scrollTo = () => {};
      stopListening();
    };
    inputs.forEach((type) => addEventListener(type, yieldToReader, { capture: true, passive: true }));
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        window.scrollTo = nativeScrollTo;
        stopListening();
      },
      { once: true },
    );
  }
  if (restoring || location.hash.length > 1) {
    const expect = document.createElement('link');
    expect.rel = 'expect';
    expect.href = '#site-footer';
    expect.setAttribute('blocking', 'render');
    document.head.append(expect);

    const land = () => {
      if (!document.getElementById('site-footer') && document.readyState === 'loading') {
        requestAnimationFrame(land);
        return;
      }
      if (restoring) {
        scrollTo(saved.scrollX ?? 0, saved.scrollY);
      } else {
        let id = location.hash.slice(1);
        try {
          id = decodeURIComponent(id);
        } catch {}
        document.getElementById(id)?.scrollIntoView();
      }
      // Images are lazy and decode async, so the first paint would show
      // their loading panels for a frame or two. Those now in view load at
      // once and decode in that paint; on a reload they're in cache.
      for (const img of document.querySelectorAll('.prose img')) {
        const { top, bottom } = img.getBoundingClientRect();
        if (bottom > 0 && top < innerHeight) {
          img.loading = 'eager';
          img.decoding = 'sync';
        }
      }
    };
    requestAnimationFrame(land);
  }
</script>
<!-- These controls need JS; without it, hide them rather than show dead ones -->
<noscript><style>.theme-toggle, .code-block__bar { display: none !important; }</style></noscript>
<!-- SVG for browsers; the .ico is what crawlers (and Google's results) fetch
     by default, and iOS wants a square PNG it rounds itself -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Jasper Gabriel"
  href={new URL("rss.xml", Astro.site)}
/>
<link
  rel="alternate"
  type="application/atom+xml"
  title="Jasper Gabriel"
  href={new URL("atom.xml", Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Jasper Gabriel" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content="Jasper Gabriel" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && (
  <>
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    <meta property="article:author" content={new URL('/about/', Astro.site)} />
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta property="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{imageURL && <meta property="twitter:image" content={imageURL} />}

{schema && <script is:inline type="application/ld+json" set:html={schema} />}
