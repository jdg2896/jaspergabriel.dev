---
import { render } from "astro:content";
import { getPosts } from "../../utils/posts";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  // getStaticPaths is hoisted out of the frontmatter, so constants live here
  const RELATED_LIMIT = 3;
  const posts = await getPosts();
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // Rare tags say more about a post than "tech" does, so a shared tag
  // counts for less the more posts carry it.
  const tagCounts = new Map<string, number>();
  for (const post of posts) {
    for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }

  return posts.map((post) => {
    const relatedPosts = posts
      .filter((other) => other.id !== post.id)
      .map((other) => ({
        other,
        score: other.data.tags
          .filter((tag) => post.data.tags.includes(tag))
          .reduce((sum, tag) => sum + 1 / tagCounts.get(tag)!, 0),
      }))
      .filter(({ score }) => score > 0)
      // Stable sort keeps newest-first among equal scores
      .sort((a, b) => b.score - a.score)
      .slice(0, RELATED_LIMIT)
      .map(({ other }) => other);

    return {
      params: { slug: post.id },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  rawContent={post.body ?? ""}
  canonicalUrl={post.data.canonicalUrl}
  slug={post.id}
  headings={headings}
  relatedPosts={relatedPosts.map((related) => ({
    slug: related.id,
    title: related.data.title,
    pubDate: related.data.pubDate,
    readingTime: getReadingTime(related.body ?? ""),
  }))}
>
  <Content />
</BlogPostLayout>
