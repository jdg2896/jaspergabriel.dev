---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "../utils/readingTime";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
// Hand-ordered by each post's `featured` position, best first
const featured = allPosts
  .filter((post) => post.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout
  title="Jasper Gabriel"
  description="Software engineer. I write about my experiences and the things I learn."
>
  <div class="container">
    <section class="hero">
      <p class="hero__greeting">Hello world, I'm</p>
      <h1 class="hero__name">Jasper Gabriel</h1>
      <p class="hero__bio">
        Software engineer specializing in backend systems and cloud
        infrastructure, with an interest in cryptography, zero-knowledge proofs,
        and cybersecurity.
      </p>
      <p class="hero__more">
        <a href="/about/">More about me <span aria-hidden="true">&rarr;</span></a>
      </p>
    </section>

    {
      featured.length > 0 && (
        <section aria-labelledby="featured-title">
          <div class="section-header">
            <h2 id="featured-title">Featured posts</h2>
            <a href="/blog/">
              All {allPosts.length} posts <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class="post-list">
            {featured.map((post) => {
              const readingTime = getReadingTime(post.body ?? "");
              return (
                <li class="post-card">
                  <div class="post-card__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                    <span aria-hidden="true">&middot;</span>
                    <span>{readingTime} min read</span>
                  </div>
                  <h3 class="post-card__title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p class="post-card__desc">{post.data.description}</p>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
